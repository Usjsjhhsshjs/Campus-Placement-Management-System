# Copy this file to ".env" and fill in your own values. Never commit ".env".
DATABASE_URL=postgresql+psycopg2://campus_user:CHANGE_ME@localhost:5432/campusconnect
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
APP_ENV=development
# Optional. Leave blank to run without email; emails are then logged as "not sent".
RESEND_API_KEY=" Your api key API_key "
EMAIL_FROM="YOUR EMAIL-ID"
